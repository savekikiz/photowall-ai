# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่า  (อย่า commit ไฟล์ .env)

PUBLIC_BASE_URL=http://localhost:8080
ADMIN_TOKEN=ตั้งรหัสเดายาก-อย่างน้อย20ตัว

# โหมดทดสอบ: ไม่เสียเครดิต ไม่ต้องมี key
IMAGE_PROVIDER=mock

# โหมดใช้งานจริง: เปลี่ยนเป็น openai แล้วใส่ key
# IMAGE_PROVIDER=openai
# OPENAI_API_KEY=sk-...
IMAGE_MODEL=gpt-image-2
IMAGE_SIZE=1024x1536
IMAGE_QUALITY=medium

# งบเวลาต่อการเรียก OpenAI 1 ครั้ง และจำนวนครั้งที่ลองซ้ำเมื่อโดน 429/5xx
# ค่าเริ่มต้นเผื่อไว้ให้จบใน ~4 นาที ซึ่งสั้นกว่า watchdog 5 นาทีเสมอ
IMAGE_TIMEOUT_MS=120000
IMAGE_MAX_ATTEMPTS=2

# เฉพาะตอนรันเองบนเครื่อง/Docker
PORT=8080
